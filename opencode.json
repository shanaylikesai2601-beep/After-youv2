{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest"],
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "oauth": false,
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      },
      "enabled": true
    },
    "figma": {
      "type": "remote",
      "url": "https://mcp.figma.com/mcp",
      "enabled": true
    },
    "gsap-master": {
      "type": "local",
      "command": ["npx", "-y", "bruzethegreat-gsap-master-mcp-server@latest"],
      "enabled": true
    },
    "threejs-assets": {
      "type": "local",
      "command": ["npx", "-y", "mcp-server-threejs"],
      "enabled": true
    }
  }
}
